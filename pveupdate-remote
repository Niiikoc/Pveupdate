#!/bin/sh
# Forced command for a restricted SSH key (see README, "Home Assistant").
# The key can only run these actions, nothing else on the host:
#   status              print the last check/update results as JSON
#   check               start a check in the background
#   update ID... | all | pending
#                       start an update in the background (no prompts)
#   log                 show the end of the update log

set -f
set -- $SSH_ORIGINAL_COMMAND
action="$1"
[ $# -gt 0 ] && shift

case "$action" in
  status)
    exec pveupdate status --json
    ;;
  check)
    exec systemctl start --no-block pveupdate-check.service
    ;;
  update)
    [ $# -gt 0 ] || { echo "update needs guest IDs, all, or pending" >&2; exit 2; }
    for id in "$@"; do
      case "$id" in
        all|pending) ;;
        ''|*[!0-9]*) echo "invalid guest ID: $id" >&2; exit 2 ;;
      esac
    done
    exec systemd-run --quiet --collect --unit=pveupdate-update \
      pveupdate update --non-interactive "$@"
    ;;
  log)
    exec tail -n 200 /var/log/pveupdate.log
    ;;
  *)
    echo "allowed: status | check | update ID... | update all | update pending | log" >&2
    exit 2
    ;;
esac
